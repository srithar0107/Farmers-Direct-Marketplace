# MongoDB Connection URI (supports Atlas cloud or local MongoDB)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/farmers_direct_marketplace?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/farmers_direct_marketplace
MONGODB_URI=mongodb://127.0.0.1:27017/farmers_direct_marketplace

# Port number for Express server
PORT=5000

# Secret key for JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Optional Live Carrier SMS Alert Integration (Twilio or Fast2SMS)
# Note: If these credentials are omitted, alerts automatically fall back to the In-App
# Alert Notification Center on the Farmer Dashboard and are safely recorded in MongoDB.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here
